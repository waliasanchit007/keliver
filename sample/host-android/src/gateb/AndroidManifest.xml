<?xml version="1.0" encoding="utf-8"?>
<!-- Gate B-e (prototype builds only): the generated group's animation route. Exported so the
     benchmarks module and `adb shell am start -n dev.keliver.sample/.gateb.GatebActivity -e mode host`
     can open it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="dev.keliver.sample.host.gateb.GatebActivity"
            android:exported="true" />
        <!-- The three-way benchmark (docs/THREE_WAY_BENCHMARK.md): the list and detail screens as
             native Compose, a Keliver guest or a web page (`-e form native|guest|web`). -->
        <activity
            android:name="dev.keliver.sample.host.threeway.ThreewayActivity"
            android:exported="true" />
    </application>
</manifest>
