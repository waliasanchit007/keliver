<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds only (ED3): the debug link that points this host at the relay's
     device proxy, @@DEBUG_LINK_SCHEME@@://keliver-debug/bundles?server=<URL>
     (KeliverDebugLinkActivity, in src/debug/kotlin, checks it and asks first).
     A release build merges no part of this file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="@@PACKAGE@@.KeliverDebugLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="@@DEBUG_LINK_SCHEME@@"
                    android:host="keliver-debug"
                    android:path="/bundles" />
            </intent-filter>
        </activity>
    </application>
</manifest>
