// This app's production host: its name and bundle id. Written by
// keliver-new-ios-host.sh. Simulator builds need no signing. For a device, set
// TEAM_ID (your Apple developer team id, 10 characters) here or, to keep it out
// of git, in Configuration/Config.local.xcconfig (gitignored; included last, so
// it wins). Signing is automatic ("Apple Development").
TEAM_ID=
DEVELOPMENT_TEAM=$(TEAM_ID)
PRODUCT_NAME=@@PRODUCT_NAME@@
PRODUCT_BUNDLE_IDENTIFIER=@@BUNDLE_ID@@
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
#include? "Config.local.xcconfig"
