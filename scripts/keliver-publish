#!/bin/bash
# keliver-publish — publish this app's signed bundle into a STATIC layout, with
# no relay: for CI, and for any static server or CDN (S3, GCS, GitHub Pages,
# nginx). Ships in keliver-portal-tools; needs Java 17+.
#
#   keliver-publish [app-dir] --out <dir> [--public-key-file <file>] [--channel stable] [--skip-build]
#
# Writes <dir>/bundles/v<N>/ (the compile task's output, unchanged) and
# <dir>/bundles/index.json (the next sequence). Serve <dir> as-is; production
# hosts scaffolded by keliver-new-production-host.sh / keliver-new-ios-host.sh
# read bundles/index.json from their bundle server.
#
# 1. Builds the app's publishTask (keliver.portal.json), with KELIVER_TOOLS_BIN
#    set so the signing block keliver-new-publish-target.sh wrote can find the
#    store. In CI, set KELIVER_SIGNING_KEY_FILE to a file holding the private
#    key instead (never print it).
# 2. Refuses, and writes nothing, unless the manifest is signed with this
#    app's key and every module it names is present with that sha256.
#
# The PUBLIC key it checks against: --public-key-file, else
# KELIVER_PUBLIC_KEY_HEX, else this app's store (keys/ed25519.pub, located by
# keliver-store-path.sh, the one shell mirror of the store contract).
#
# Exit status: 0 published, 2 usage, 3 build failed, 4 refused.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUNDLE="$(cd "$HERE/.." && pwd)"
# The tools bundle's relay install holds the JVM entry point; KELIVER_RELAY_HOME
# points at another install (portal-relay's installDist in a Keliver checkout).
JVM="${KELIVER_RELAY_HOME:-$BUNDLE/relay}/bin/keliver-publish-jvm"
[ -x "$JVM" ] || { echo "keliver-publish: $JVM not found (run from an unpacked keliver-portal-tools)" >&2; exit 2; }

APP_ARG="."
HAS_KEY=false
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) sed -n '2,24p' "${BASH_SOURCE[0]}"; exit 0 ;;
    --public-key-file) HAS_KEY=true; ARGS+=("$1" "${2:-}"); shift ;;
    --out|--channel) ARGS+=("$1" "${2:-}"); shift ;;
    --skip-build) ARGS+=("$1") ;;
    -*) echo "keliver-publish: unknown option $1" >&2; exit 2 ;;
    *) APP_ARG="$1" ;;
  esac
  shift
done
APP_DIR="$(cd "$APP_ARG" 2>/dev/null && pwd)" || { echo "keliver-publish: no such directory: $APP_ARG" >&2; exit 2; }

if ! $HAS_KEY && [ -z "${KELIVER_PUBLIC_KEY_HEX:-}" ]; then
  STORE="$("$HERE/keliver-store-path.sh" "$APP_DIR")" || {
    echo "keliver-publish: could not locate this app's store; pass --public-key-file (the key your hosts embed)" >&2; exit 2; }
  [ -f "$STORE/keys/ed25519.pub" ] || {
    echo "keliver-publish: no public key at $STORE/keys/ed25519.pub; pass --public-key-file" >&2; exit 2; }
  ARGS+=(--public-key-file "$STORE/keys/ed25519.pub")
fi

export KELIVER_TOOLS_BIN="${KELIVER_TOOLS_BIN:-$HERE}"
exec "$JVM" "$APP_DIR" ${ARGS[@]+"${ARGS[@]}"}
