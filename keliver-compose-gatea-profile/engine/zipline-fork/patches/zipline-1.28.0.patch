+      |  const named = new Named('n').increment().increment();
+      |  const adder = makeAdder(10);
+      |  const { a, ...rest } = { a: 1, b: 2, c: 3 };
+      |  let out = [String(named), Counter.instances(), adder(5), adder(1), [...range(4)].join(''),
+      |    a, Object.keys(rest).join('')];
+      |  later(21).then((v) => { globalThis.laterResult = v; });
+      |  return out.join(',');
+      |}
+      """.trimMargin()
+    val bytecode = quickJs.compile(script, "classes.js")
+    val evalFunction = assertRoundTrip(script, "classes.js")
+    // QuickJS 2026 names class constructors and methods when the class is defined, so their
+    // bytecode has no name (JS_ATOM_NULL).
+    assertThat(evalFunction.constantPool.filterIsInstance<JsFunctionBytecode>().map { it.name })
+      .containsAtLeast("makeAdder", "range", "later", "agen", "run")
+
+    quickJs.execute(roundTrip(bytecode))
+    assertThat(quickJs.evaluate("run()")).isEqualTo("n=2,1,15,16,0123,1,bc")
+  }
+
+  /** The atom table above QuickJS's built-in atoms is the file's; the built-in ones are ours. */
+  @Test fun builtInAtomsMatchTheEngine() {
+    // quickjs-atom.h, from the engine this module's tests run against.
+    val header = File("../zipline/native/quickjs/quickjs-atom.h").readText()
+    val engineAtoms = Regex("""^DEF\(\w+,\s*"((?:[^"\\]|\\.)*)"\)""", RegexOption.MULTILINE)
+      .findAll(header)
+      .map { it.groupValues[1].replace("\\\\", "\\").replace("\\\"", "\"") }
+      .toList()
+    assertThat(BUILT_IN_ATOMS.drop(1).map { it.string }).isEqualTo(engineAtoms)
+    assertThat(BUILT_IN_ATOMS.first().string).isEqualTo("\u0000") // JS_ATOM_NULL
+  }
+
+  /** Every built-in atom QuickJS uses for a name reads as itself. */
+  @Test fun builtInAtomsInNames() {
+    val evalFunction = assertRoundTrip(
+      """
+      |function Symbol() {}
+      |function asyncIterator() {}
+      |function Float16Array() {}
+      |function FinalizationRegistry() {}
+      |function toPrimitive(hint, ...rest) { let length = 1; return length; }
+      """.trimMargin(),
+    )
+    assertThat(evalFunction.constantPool.filterIsInstance<JsFunctionBytecode>().map { it.name })
+      .isEqualTo(listOf("Symbol", "asyncIterator", "Float16Array", "FinalizationRegistry", "toPrimitive"))
+    val toPrimitive = evalFunction.constantPool.filterIsInstance<JsFunctionBytecode>().last()
+    assertThat(toPrimitive.locals.map { it.name }).containsAtLeast("hint", "rest", "length")
+  }
+
+  /**
+   * A file name with the text of a built-in symbol is a string atom of the file's own, and writes
+   * back as itself (the built-in symbol's index would make it the symbol).
+   */
+  @Test fun namesLikeBuiltInSymbolsRoundTrip() {
+    val evalFunction = assertRoundTrip("function f() { throw Error('boom'); }", "Symbol.iterator")
+    assertThat(evalFunction.debug!!.fileName).isEqualTo("Symbol.iterator")
+    quickJs.execute(roundTrip(quickJs.compile("function g() { throw Error('boom'); }", "Symbol.iterator")))
+    val stack = quickJs.evaluate("try { g(); 'no exception' } catch (e) { e.stack }") as String
+    assertThat(stack).startsWith("    at g (Symbol.iterator:1:")
+  }
+
+  /**
+   * Version 5's debug record has the function's source text. The fork's `QuickJs.compile` leaves
+   * it out (as QuickJS 2021 did), but the record must still read and write when it is there.
+   */
+  @Test fun functionSource() {
+    val evalFunction = assertRoundTrip("function f(a) { return a + 1; }", "source.js")
+    val f = evalFunction.constantPool.single() as JsFunctionBytecode
+    assertThat(f.debug!!.source.size).isEqualTo(0)
+
+    val withSource = evalFunction.copy(
+      constantPool = listOf(f.copy(debug = f.debug!!.copy(source = "function f(a) { return a + 1; }".encodeUtf8()))),
+    )
+    val atoms = JsObjectReader(quickJs.compile("function f(a) { return a + 1; }", "source.js"))
+      .let { reader -> reader.use { it.readJsObject() }; reader.atoms }
+    val bytes = Buffer().also { JsObjectWriter(atoms, it).use { w -> w.writeJsObject(withSource) } }
+      .readByteArray()
+    assertThat(JsObjectReader(bytes).use { it.readJsObject() }).isEqualTo(withSource)
+    // Function.prototype.toString uses it.
+    quickJs.execute(bytes)
+    assertThat(quickJs.evaluate("f.toString()")).isEqualTo("function f(a) { return a + 1; }")
+  }
+
+  private fun roundTrip(bytecode: ByteArray): ByteArray {
+    val reader = JsObjectReader(bytecode)
+    val decoded = reader.use { it.readJsObject() }
+    val buffer = Buffer()
+    JsObjectWriter(reader.atoms, buffer).use { it.writeJsObject(decoded) }
+    return buffer.readByteArray()
+  }
 }
