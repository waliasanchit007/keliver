+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package app.cash.zipline
+
+import app.cash.zipline.internal.bridge.INBOUND_CHANNEL_NAME
+import kotlin.test.AfterTest
+import kotlin.test.Test
+import kotlin.test.assertContentEquals
+import kotlin.test.assertEquals
+import kotlin.test.assertNotEquals
+import kotlin.test.assertNull
+
+/**
+ * Keliver's fork (NF2): what QuickJS 2026-06-04 changes for Zipline. BigInt is in the engine, so
+ * Kotlin/JS output with `Long` as BigInt compiles and runs; BigInts cross to the host as `Long`;
+ * long concatenations may be ropes (`JS_TAG_STRING_ROPE`), which must still read as strings.
+ */
+class QuickJs2026Test {
+  private var quickJs = QuickJs.create()
+
+  @AfterTest fun tearDown() {
+    quickJs.close()
+  }
+
+  @Test fun version() {
+    assertEquals("2026-06-04", QuickJs.version)
+  }
+
+  @Test fun compilerAcceptsBigInt() {
+    // The shape of Kotlin's -Xes-long-as-bigint output for `Long.ushr`.
+    val code = quickJs.compile(
+      """
+      function ushr(a, n) { return BigInt.asIntN(64, BigInt.asUintN(64, a) >> BigInt(n)); }
+      String(ushr(-1n, 1)) + ' ' + String(BigInt.asUintN(64, -1n)) + ' ' + typeof 1n;
+      """.trimIndent(),
+      "bigint.js",
+    )
+    assertNotEquals(0, code.size)
+
+    quickJs.close()
+    quickJs = QuickJs.create()
+    assertEquals("9223372036854775807 18446744073709551615 bigint", quickJs.execute(code))
+  }
+
+  /**
+   * QuickJS 2026 would write each function's source text into the bytecode (2021 did not), most of
+   * a Kotlin/JS bundle's bytes; `compile` leaves it out (step 1b).
+   */
+  @Test fun compileLeavesOutFunctionSource() {
+    val source = "function sourceTextOfF(a) { return a + 1; }"
+    val code = quickJs.compile(source, "f.js")
+    assertEquals(-1, code.decodeToString().indexOf("sourceTextOfF(a) { return"))
+
+    quickJs.close()
+    quickJs = QuickJs.create()
+    quickJs.execute(code)
+    assertEquals(2, quickJs.evaluate("sourceTextOfF(1)"))
+    // What 1.28.0 (QuickJS 2021) gave for any function loaded from bytecode.
+    assertEquals("function sourceTextOfF() {\n    [native code]\n}", quickJs.evaluate("sourceTextOfF.toString()"))
+  }
+
+  /**
+   * `evaluate` compiles through `compile` on every host (JNI and Kotlin/Native alike; 1.28.0 has no
+   * separate eval), so an evaluated function has no source text either (step 3). Run on the JVM and
+   * the iOS simulator; it is in Android's device tests too, which step 3 did not run.
+   */
+  @Test fun evaluateLeavesOutFunctionSource() {
+    assertEquals(
+      "function evaluatedF() {\n    [native code]\n}",
+      quickJs.evaluate("function evaluatedF(a) { return a + 1; }; evaluatedF.toString()"),
+    )
+    assertEquals(3, quickJs.evaluate("evaluatedF(2)"))
+  }
+
+  @Test fun asUintNIsGeneral() {
+    // Each was wrong in the unpatched 2026-06-04 release (docs/GUEST_PROFILE.md, NF2).
+    assertEquals("18446744073709551615", quickJs.evaluate("String(BigInt.asUintN(64, -1n))"))
+    assertEquals("36893488147419103231", quickJs.evaluate("String(BigInt.asUintN(65, -1n))"))
+    assertEquals("9223372036854775808", quickJs.evaluate("String(BigInt.asUintN(64, 2n**64n + 2n**63n))"))
+    assertEquals(
+      "340282366920938463463374607431768211455",
+      quickJs.evaluate("String(BigInt.asUintN(128, -1n))"),
+    )
+    assertEquals("-1", quickJs.evaluate("String(BigInt.asIntN(64, -1n))"))
+    assertEquals("127", quickJs.evaluate("String(BigInt.asUintN(7, -1n))"))
+  }
+
+  @Test fun asUintNAtTheSizeLimit() {
+    // QuickJS caps a BigInt at 2^20 bits (Node at 2^30, so bigint-ops.js cannot compare this). A
+    // negative value at a width of 2^20 or more needs one bit more than that: a RangeError, not a
+    // crash or a truncated result. One bit narrower fits; a non-negative value is returned as is.
+    assertEquals(1_048_575, quickJs.evaluate("BigInt.asUintN(2 ** 20 - 1, -1n).toString(2).length"))
+    for (width in listOf("2 ** 20", "2 ** 30", "2 ** 53 - 1")) {
+      assertEquals(
+        "RangeError",
+        quickJs.evaluate(
+          "try { BigInt.asUintN($width, -1n); 'none' } catch (e) { e instanceof RangeError ? 'RangeError' : String(e) }",
+        ),
+      )
+      assertEquals("12345", quickJs.evaluate("String(BigInt.asUintN($width, 12345n))"))
+      assertEquals("-1", quickJs.evaluate("String(BigInt.asIntN($width, -1n))"))
+    }
+  }
+
+  @Test fun bigIntsReturnAsLong() {
+    assertEquals(1L, quickJs.evaluate("1n"))
+    assertEquals(-1L, quickJs.evaluate("-1n"))
+    assertEquals(Long.MAX_VALUE, quickJs.evaluate("2n**63n - 1n"))
+    assertEquals(Long.MIN_VALUE, quickJs.evaluate("-(2n**63n)"))
+    assertEquals(4_294_967_296L, quickJs.evaluate("2n**32n"))
+    assertContentEquals(
+      arrayOf<Any?>(1L, "x", 1),
+      quickJs.evaluate("[1n, 'x', 1]") as Array<Any?>,
+    )
+  }
+
+  @Test fun bigIntsOutsideLongAreUnsupported() {
+    // Like any other value the host cannot convert: no silent truncation.
+    assertNull(quickJs.evaluate("2n**63n"))
+    assertNull(quickJs.evaluate("-(2n**63n) - 1n"))
+    assertNull(quickJs.evaluate("2n**64n"))
+  }
+
+  @Test fun ropeStringsReturnAsStrings() {
+    val result = quickJs.evaluate("'a'.repeat(10000) + 'b'.repeat(10000)") as String
+    assertEquals(20_000, result.length)
+    assertEquals('b', result.last())
+  }
+
+  @Test fun inboundCallMayReturnARope() {
+    quickJs.evaluate(
+      """
+      globalThis.$INBOUND_CHANNEL_NAME = {
+        call: function(callJson) { return callJson + '|' + 'r'.repeat(10000) + 's'.repeat(10000); },
+        disconnect: function(instanceName) { return true; },
+      };
+      """.trimIndent(),
+    )
+    val result = quickJs.getInboundChannel().call("first")
+    assertEquals(6 + 20_000, result.length)
+    assertEquals("first|", result.substring(0, 6))
+  }
+}
