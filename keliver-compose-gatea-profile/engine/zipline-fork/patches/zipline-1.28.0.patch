+package app.cash.zipline.bytecode
+
+import app.cash.zipline.QuickJs
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import assertk.assertions.isTrue
+import java.io.File
+import okio.Buffer
+import okio.ByteString
+import okio.ByteString.Companion.toByteString
+import org.junit.Assume.assumeTrue
+import org.junit.Test
+
+/**
+ * Keliver fork (NF2 step 1b): real Kotlin/JS bundles through version 5, the way Zipline's compiler
+ * uses this module. Point `-PziplineBytecodeCorpus=<dir>[:<dir>...]` at directories of `.js` files
+ * (with their `.js.map` files, as Kotlin writes them); skipped without it.
+ *
+ * For every module: QuickJS's bytecode reads and writes back byte for byte; with its source map
+ * applied, every function's file, header and recorded position (line and column) is consistent
+ * with `applySourceMap`'s rule (a second implementation of it here, from the parsed segments: this
+ * checks the rule was applied everywhere, not that its Kotlin positions are right); stripped, no
+ * function keeps a line table or source text. Then the bundle is loaded in dependency
+ * order three times (as compiled, source maps applied, stripped), and each load must end as the
+ * first one did.
+ */
+class RealBundleTest {
+  private val corpus = System.getProperty("ziplineBytecodeCorpus").orEmpty()
+    .split(File.pathSeparator).filter { it.isNotBlank() }.map { File(it) }
+
+  @Test fun realBundles() {
+    assumeTrue("set -PziplineBytecodeCorpus to run", corpus.isNotEmpty())
+    for (dir in corpus) {
+      val modules = dir.listFiles { f -> f.name.endsWith(".js") }!!.sortedBy { it.name }
+      check(modules.isNotEmpty()) { "no .js files in $dir" }
+      val compiled = linkedMapOf<String, ByteArray>()
+      val applied = linkedMapOf<String, ByteArray>()
+      val stripped = linkedMapOf<String, ByteArray>()
+      val stats = Stats()
+      QuickJs.create().use { quickJs ->
+        for (js in modules) {
+          val bytecode = quickJs.compile(js.readText(), js.name)
+          compiled[js.name] = bytecode
+          val model = assertRoundTrip(bytecode, stats)
+
+          val mapFile = File("${js.path}.map")
+          val withMap = if (mapFile.exists()) {
+            val sourceMap = SourceMap.parse(mapFile.readText()).clean()
+            val result = applySourceMapToBytecode(bytecode, sourceMap)
+            val mapped = assertRoundTrip(result, null)
+            stats.mappedFunctions += assertMapped(model, mapped, sourceMap, stats)
+            stats.modulesWithMaps++
+            result
+          } else {
+            bytecode
+          }
+          applied[js.name] = withMap
+
+          val strippedBytecode = stripLineNumbers(withMap)
+          val strippedModel = assertRoundTrip(strippedBytecode, null)
+          assertThat(
+            strippedModel.functions().all {
+              it.debug == null || (it.debug.pc2Line.size == 0 && it.debug.source.size == 0)
+            },
+          ).isTrue()
+          stripped[js.name] = strippedBytecode
+          stats.bytesCompiled += bytecode.size
+          stats.bytesApplied += withMap.size
+          stats.bytesStripped += strippedBytecode.size
+        }
+      }
+
+      val order = loadOrder(compiled)
+      val asCompiled = load(order, compiled)
+      assertThat(load(order, applied)).isEqualTo(asCompiled)
+      assertThat(load(order, stripped)).isEqualTo(asCompiled)
+      println(
+        "RealBundleTest ${dir.path}: ${modules.size} modules (${stats.modulesWithMaps} with source " +
+          "maps), ${stats.functions} functions, ${stats.mappedFunctions} mapped (file from the " +
+          "header ${stats.headerFiles}, not 1.28.0's file ${stats.filesNotFirstMappedLine}; " +
+          "positions covered in another file ${stats.otherFilePositions}); byte-identical " +
+          "round trips; bytes compiled ${stats.bytesCompiled}, source maps applied " +
+          "${stats.bytesApplied}, stripped ${stats.bytesStripped}; function source text " +
+          "${stats.sourceBytes} bytes, pc2line ${stats.pc2LineBytes} bytes; " +
+          "BigInt constants ${stats.bigInts}; load: ${asCompiled.joinToString()}",
+      )
+    }
+  }
+
+  private class Stats {
+    var functions = 0
+    var mappedFunctions = 0
+    var modulesWithMaps = 0
+    var bytesCompiled = 0L
+    var bytesApplied = 0L
+    var bytesStripped = 0L
+    var sourceBytes = 0L
+    var pc2LineBytes = 0L
+    var bigInts = 0
+
+    /** Mapped functions whose file is their own position's covering segment's. */
+    var headerFiles = 0
+
+    /** Mapped functions whose file is not 1.28.0's (its first mapped line's first file). */
+    var filesNotFirstMappedLine = 0
+
+    /** Positions whose covering segment is in another file than their function's. */
+    var otherFilePositions = 0
+  }
+
+  private fun assertRoundTrip(bytecode: ByteArray, stats: Stats?): JsObject {
+    val reader = JsObjectReader(bytecode)
+    val model = reader.use { it.readJsObject() }
+    val buffer = Buffer()
+    JsObjectWriter(reader.atoms, buffer).use { it.writeJsObject(model) }
+    assertThat(buffer.readByteString()).isEqualTo(bytecode.toByteString())
+    if (stats != null) {
+      val functions = model.functions()
+      stats.functions += functions.size
+      stats.sourceBytes += functions.sumOf { it.debug?.source?.size ?: 0 }
+      stats.pc2LineBytes += functions.sumOf { it.debug?.pc2Line?.size ?: 0 }
+      stats.bigInts += model.all().count { it is JsBigInt }
+    }
+    return model
+  }
+
+  /**
+   * Checks the mapped bytecode against the source map, position by position: the function's own
+   * position (the table's header) and, at every pc where the JavaScript table has an entry, the
+   * Kotlin line and column. The expected values come from the rule `applySourceMap` states (see
+   * [expectedPositions]), computed again here from the parsed segments, so this shows the rule
+   * was applied to every position of a real bundle, consistently; it cannot show the rule's
+   * Kotlin positions are right. Independent checks of those are the stack traces in
+   * `ApplySourceMapToBytecodeTest` and `ZiplineCompilerTest`, against hand-checked Kotlin lines.
+   * Returns the number of functions given a Kotlin file.
+   */
+  private fun assertMapped(js: JsObject, kt: JsObject, sourceMap: SourceMap, stats: Stats): Int {
+    val jsFunctions = js.functions()
+    val ktFunctions = kt.functions()
+    assertThat(ktFunctions.size).isEqualTo(jsFunctions.size)
+    var mapped = 0
+    for ((jsFunction, ktFunction) in jsFunctions.zip(ktFunctions)) {
+      assertThat(ktFunction.bytecode).isEqualTo(jsFunction.bytecode)
+      val jsDebug = jsFunction.debug ?: continue
+      val ktDebug = ktFunction.debug!!
+      val jsPositions = jsDebug.pc2Line.positions()
+      val expected = expectedPositions(jsPositions, sourceMap)
+      if (expected == null) {
+        // Nothing in the function was mapped: the debug record is the JavaScript one.
+        assertThat(ktDebug).isEqualTo(jsDebug)
+        continue
+      }
+      mapped++
+      val file = expected.first
+      val covering = jsPositions.map { (_, line, column) -> sourceMap.covering(line, column)?.source }
+      if (covering[0] == file) stats.headerFiles++
+      if (jsPositions.firstNotNullOfOrNull { sourceMap.findMapped(it.second)?.source } != file) {
+        stats.filesNotFirstMappedLine++
+      }
+      stats.otherFilePositions += covering.count { it != null && it != file }
+      assertThat(ktDebug.fileName, "${jsFunction.name}").isEqualTo(file)
+      val ktPositions = ktDebug.pc2Line.positions()
+      assertThat(ktPositions.first(), "${jsFunction.name} header").isEqualTo(expected.second.first())
+      for ((jsPosition, expectedPosition) in jsPositions.zip(expected.second).drop(1)) {
+        val pc = jsPosition.first
+        assertThat(findPosition(ktPositions, pc), "${jsFunction.name} pc $pc").isEqualTo(expectedPosition)
+      }
+    }
+    return mapped
+  }
+
+  /**
+   * The rule, from the segments. The covering segment of a position is the last on its line
+   * starting at or before its column. The function's file is the header's covering segment's
+   * source if it has one, else the source of the first segment with one on the line of its first
+   * position that has one. Each position takes its covering segment if that segment's source is the function's
+   * file, else its line's first segment in the function's file; with neither, the previous
+   * position's result (the header, and positions before the first mapped one: the first mapped
+   * one's). A segment in another file is never used. Returns the file and, per position, the pc
+   * and expected line and column; null when nothing is mapped.
+   */
+  private fun expectedPositions(
+    positions: List<Triple<Int, Int, Int>>,
+    sourceMap: SourceMap,
+  ): Pair<String, List<Triple<Int, Int, Int>>>? {
+    fun segments(line: Int) = sourceMap.groups.getOrNull(line - 1)?.segments.orEmpty()
+    val covering = positions.map { (_, line, column) ->
+      segments(line).lastOrNull { it.startingColumn <= column }
+    }
+    val file = covering[0]?.source
+      ?: positions.firstNotNullOfOrNull { (_, line, _) ->
+        segments(line).firstOrNull { it.source != null }?.source
+      }
+      ?: return null
+    val found = positions.mapIndexed { i, (_, line, _) ->
+      val segment = covering[i]?.takeIf { it.source == file } ?: segments(line).firstOrNull { it.source == file }
+      segment?.let { it.sourceLine.toInt() to it.sourceColumn.toInt() }
+    }
+    var previous = found.first { it != null }!!
+    val result = found.mapIndexed { i, position ->
+      val p = position ?: previous
+      previous = p
+      Triple(positions[i].first, p.first, p.second)
+    }
+    return file to result
+  }
+
+  /** The header (pc 0) and each entry: pc, line and column. */
+  private fun ByteString.positions(): List<Triple<Int, Int, Int>> {
+    val result = mutableListOf<Triple<Int, Int, Int>>()
+    LineNumberReader(Buffer().write(this)).use { reader ->
+      result += Triple(0, reader.line, reader.column)
+      while (reader.next()) result += Triple(reader.pc, reader.line, reader.column)
+    }
+    return result
+  }
+
+  /** QuickJS's `find_line_num`: the position of the last entry at or before [pc] (or the header). */
+  private fun findPosition(positions: List<Triple<Int, Int, Int>>, pc: Int): Triple<Int, Int, Int> {
+    var result = positions.first()
+    for (position in positions.drop(1)) {
+      if (pc < position.first) break
+      result = position
+    }
+    return Triple(pc, result.second, result.third)
+  }
+
+  private fun JsObject.all(): List<JsObject> = when (this) {
+    is JsFunctionBytecode -> listOf(this) + constantPool.flatMap { it.all() }
+    is JsArray -> listOf(this) + elements.flatMap { it.all() } + raw.all()
+    else -> listOf(this)
+  }
+
+  private fun JsObject.functions(): List<JsFunctionBytecode> =
+    all().filterIsInstance<JsFunctionBytecode>()
+
+  @Suppress("INVISIBLE_REFERENCE", "INVISIBLE_MEMBER") // Access :zipline internals.
+  private fun loadOrder(modules: Map<String, ByteArray>): List<String> {
+    val dependencies = modules.mapValues { (_, bytecode) ->
+      QuickJs.create().use { quickJs ->
+        app.cash.zipline.internal.collectModuleDependencies(quickJs)
+        quickJs.execute(bytecode)
+        app.cash.zipline.internal.getModuleDependencies(quickJs)
+          .map { it.removePrefix("./") }
+          .filter { it in modules }
+      }
+    }
+    val result = mutableListOf<String>()
+    fun visit(name: String, path: Set<String>) {
+      if (name in result) return
+      check(name !in path) { "dependency cycle at $name" }
+      for (dependency in dependencies.getValue(name)) visit(dependency, path + name)
+      result += name
+    }
+    for (name in modules.keys) visit(name, emptySet())
+    return result
+  }
+
+  /** Loads every module as Zipline's loader does; returns "ok" or the failure for each. */
+  @Suppress("INVISIBLE_REFERENCE", "INVISIBLE_MEMBER") // Access :zipline internals.
+  private fun load(order: List<String>, modules: Map<String, ByteArray>): List<String> {
+    QuickJs.create().use { quickJs ->
+      app.cash.zipline.internal.initModuleLoader(quickJs)
+      return order.map { name ->
+        try {
+          app.cash.zipline.internal.loadJsModule(quickJs, "./$name", modules.getValue(name))
+          "$name ok"
+        } catch (e: Exception) {
+          "$name ${e.message}"
+        }
+      }
+    }
+  }
+}
