+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package app.cash.zipline
+
+import app.cash.zipline.internal.bridge.INBOUND_CHANNEL_NAME
+import kotlin.test.AfterTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertTrue
+
+/**
+ * Keliver's fork (NF2), on every host (JNI on the JVM and Android, Kotlin/Native on iOS): an inbound
+ * call or disconnect whose JavaScript returns the wrong type throws [IllegalStateException]
+ * (upstream's JNI layer left the result unset behind an assert that release builds compile out;
+ * its iOS layer threw a cast exception before freeing anything), and every value is freed on every
+ * path: a wrong type, a JavaScript exception, and disconnect's argument and result.
+ *
+ * [tearDown] closes the engine, so a leaked object fails these tests on iOS too: QuickJS is built
+ * there with its asserts, and JS_FreeRuntime asserts that no object is left.
+ */
+class QuickJs2026InboundChannelTest {
+  private val quickJs = QuickJs.create()
+
+  @AfterTest fun tearDown() {
+    quickJs.close()
+  }
+
+  private fun inboundReturns(callResult: String, disconnectResult: String) {
+    quickJs.evaluate(
+      """
+      globalThis.$INBOUND_CHANNEL_NAME = {
+        call: function(callJson) { return $callResult; },
+        disconnect: function(instanceName) { return $disconnectResult; },
+      };
+      """.trimIndent(),
+    )
+  }
+
+  @Test fun inboundCallWithANonStringResultThrows() {
+    inboundReturns(callResult = "42", disconnectResult = "true")
+    val t = assertFailsWith<IllegalStateException> {
+      quickJs.getInboundChannel().call("first")
+    }
+    assertTrue(t.message!!.startsWith("Unexpected result from the inbound call"), t.message)
+
+    // The context is still usable.
+    inboundReturns(callResult = "'ok'", disconnectResult = "true")
+    assertEquals("ok", quickJs.getInboundChannel().call("second"))
+  }
+
+  @Test fun inboundCallWithAnUndefinedResultThrows() {
+    inboundReturns(callResult = "undefined", disconnectResult = "true")
+    assertFailsWith<IllegalStateException> {
+      quickJs.getInboundChannel().call("first")
+    }
+  }
+
+  @Test fun inboundDisconnectWithANonBooleanResultThrows() {
+    inboundReturns(callResult = "'ok'", disconnectResult = "'yes'")
+    val t = assertFailsWith<IllegalStateException> {
+      quickJs.getInboundChannel().disconnect("one")
+    }
+    assertTrue(t.message!!.startsWith("Unexpected result from the inbound disconnect"), t.message)
+  }
+
+  @Test fun inboundCallWithAnObjectResultFreesIt() {
+    inboundReturns(callResult = "{ leaked: [1, 2, 3] }", disconnectResult = "true")
+    val channel = quickJs.getInboundChannel()
+    // The first call may allocate shapes and atoms; measure after it.
+    assertFailsWith<IllegalStateException> { channel.call("warm-up") }
+    quickJs.gc()
+    val before = quickJs.memoryUsage.objectsCount
+    repeat(1_000) {
+      assertFailsWith<IllegalStateException> { channel.call("call $it") }
+    }
+    quickJs.gc()
+    val after = quickJs.memoryUsage.objectsCount
+    assertTrue(after - before < 10, "objects before $before, after $after")
+  }
+
+  @Test fun inboundDisconnectFreesItsResult() {
+    // An object result was never freed: its reference count stayed at one, so not even a GC
+    // could collect it. 1,000 disconnects must not leave 1,000 objects behind.
+    inboundReturns(callResult = "'ok'", disconnectResult = "{ leaked: [1, 2, 3] }")
+    val channel = quickJs.getInboundChannel()
+    // The first call may allocate shapes and atoms; measure after it.
+    assertFailsWith<IllegalStateException> { channel.disconnect("warm-up") }
+    quickJs.gc()
+    val before = quickJs.memoryUsage.objectsCount
+    repeat(1_000) {
+      assertFailsWith<IllegalStateException> { channel.disconnect("instance $it") }
+    }
+    quickJs.gc()
+    val after = quickJs.memoryUsage.objectsCount
+    assertTrue(after - before < 10, "objects before $before, after $after")
+  }
+
+  @Test fun inboundDisconnectFreesItsArgument() {
+    // Upstream's iOS layer never freed the instance name: one string per disconnect.
+    inboundReturns(callResult = "'ok'", disconnectResult = "true")
+    val channel = quickJs.getInboundChannel()
+    assertTrue(channel.disconnect("warm-up"))
+    quickJs.gc()
+    val before = quickJs.memoryUsage.stringsCount
+    repeat(1_000) {
+      assertTrue(channel.disconnect("instance $it"))
+    }
+    quickJs.gc()
+    val after = quickJs.memoryUsage.stringsCount
+    assertTrue(after - before < 10, "strings before $before, after $after")
+  }
+
+  @Test fun inboundCallThatThrowsFreesEverything() {
+    // A JavaScript exception: upstream's iOS layer threw it before freeing the result's receiver,
+    // the global object, the atom and the argument; closing the engine then failed QuickJS's
+    // assert that no object is left.
+    quickJs.evaluate(
+      """
+      globalThis.$INBOUND_CHANNEL_NAME = {
+        call: function(callJson) { throw new Error('boom: ' + callJson); },
+        disconnect: function(instanceName) { throw new Error('bang: ' + instanceName); },
+      };
+      """.trimIndent(),
+    )
+    val channel = quickJs.getInboundChannel()
+    quickJs.gc()
+    val objectsBefore = quickJs.memoryUsage.objectsCount
+    val stringsBefore = quickJs.memoryUsage.stringsCount
+    repeat(100) {
+      // The first line: on iOS the message goes on with the JavaScript stack.
+      val call = assertFailsWith<QuickJsException> { channel.call("call $it") }
+      assertEquals("boom: call $it", call.message!!.lineSequence().first())
+      val disconnect = assertFailsWith<QuickJsException> { channel.disconnect("instance $it") }
+      assertEquals("bang: instance $it", disconnect.message!!.lineSequence().first())
+    }
+    quickJs.gc()
+    val objectsAfter = quickJs.memoryUsage.objectsCount
+    val stringsAfter = quickJs.memoryUsage.stringsCount
+    assertTrue(objectsAfter - objectsBefore < 10, "objects before $objectsBefore, after $objectsAfter")
+    assertTrue(stringsAfter - stringsBefore < 10, "strings before $stringsBefore, after $stringsAfter")
+
+    // The context is still usable.
+    inboundReturns(callResult = "'ok'", disconnectResult = "true")
+    assertEquals("ok", quickJs.getInboundChannel().call("after"))
+  }
+}
