+
+// Keliver fork (NF2): a BigInt in the signed 64-bit range, as Kotlin/JS emits for Long with
+// -Xes-long-as-bigint. Returns 1 and stores the value when it fits, otherwise 0. JS_ToBigInt64
+// wraps modulo 2^64, so the value is in range when it reads back unchanged. Out of memory drops
+// the engine's pending exception and returns 0 (unsupported), as on JNI (Context.cpp).
+static inline int JsBigIntToInt64InRange(JSContext* ctx, JSValue v, int64_t* out) {
+  if (JS_ToBigInt64(ctx, out, v) != 0) {
+    JS_FreeValue(ctx, JS_GetException(ctx));
+    return 0;
+  }
+  JSValue back = JS_NewBigInt64(ctx, *out);
+  if (JS_IsException(back)) {
+    JS_FreeValue(ctx, JS_GetException(ctx));
+    return 0;
+  }
+  int inRange = JS_StrictEq(ctx, back, v) ? 1 : 0;
+  JS_FreeValue(ctx, back);
+  return inRange;
+}
