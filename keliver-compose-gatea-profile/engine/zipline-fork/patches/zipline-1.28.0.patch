@@ -55,3 +55,19 @@ static inline JSCFunctionListEntry JsDisconnectFunction(void *func) {
 static inline JSValue JsValueArrayToInstanceRef(JSValue* v, int i) {
   return v[i];
 }
+
+#include <string.h>
+
+// Keliver fork (NF2): a BigInt in the signed 64-bit range, as Kotlin/JS emits for Long with
+// -Xes-long-as-bigint. Returns 1 and stores the value when it fits, otherwise 0.
+static inline int JsBigIntToInt64InRange(JSContext* ctx, JSValue v, int64_t* out) {
+  if (JS_ToBigInt64(ctx, out, v) != 0) return 0;
+  JSValue back = JS_NewBigInt64(ctx, *out);
+  const char* backStr = JS_ToCString(ctx, back);
+  const char* str = JS_ToCString(ctx, v);
+  int inRange = backStr && str && strcmp(backStr, str) == 0;
+  JS_FreeCString(ctx, str);
+  JS_FreeCString(ctx, backStr);
+  JS_FreeValue(ctx, back);
+  return inRange;
+}
