  "errors": [
    {"spec": "androidx.compose.ui.layout.Layout(content,modifier,measurePolicy)",
     "message": "custom measuring runs per frame on the host. Use Row, Column or Box with weight and align, FlowRow, or an app component."},
    {"spec": "androidx.compose.ui.input.pointer.pointerInput(key1,block:Function0)",
     "message": "raw pointer handlers run per event on the host. Use Modifier.clickable (or, in Gate B, combinedClickable, draggable, anchoredDraggable)."},
    {"spec": "androidx.compose.material3.Scaffold(modifier,topBar,bottomBar,snackbarHost,floatingActionButton,floatingActionButtonPosition,containerColor,contentColor,contentWindowInsets,content)",
     "message": "Scaffold's content takes the PaddingValues the host measures (a slot with a parameter: Gate B, part b). Use a Column with the TopAppBar and Modifier.weight(1f) on the content."}
  ],
  "typeMessages": {
    "androidx.compose.ui.text.TextLayoutResult": "a text layout result is measured on the host and cannot reach the guest. Use maxLines and overflow.",
    "androidx.compose.foundation.text.TextAutoSize": "auto-sized text is not in the generated API yet (Gate B, part b). Use fontSize with maxLines and overflow.",
    "androidx.compose.ui.graphics.Brush": "brushes are Gate B. Use a solid Color.",
    "coil3.compose.AsyncImagePainter.State": "image-loading state callbacks are Gate B.",
