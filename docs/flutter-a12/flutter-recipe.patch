+ * Licensed under the Apache License, Version 2.0.
+ */
+package dev.keliver.sample.host.threeway
+
+import android.content.Context
+import android.os.SystemClock
+import android.util.Log
+import io.flutter.embedding.engine.FlutterEngine
+import io.flutter.embedding.engine.dart.DartExecutor
+import io.flutter.plugin.common.MethodChannel
+
+/**
+ * The fourth form, Flutter (docs/THREE_WAY_BENCHMARK.md, "Flutter on the A12"; a recipe kept out of
+ * main): the bench's Flutter module (an AAR from `flutter build aar`, release/AOT) in this activity,
+ * in a `FlutterView` attached to a `FlutterEngine` (add-to-app), with one of two engine policies:
+ *
+ * - on demand (as shipped): the activity creates the engine and runs its Dart entrypoint in onCreate;
+ * - `x=prewarm`: the engine is created and its entrypoint run in bindApplication, from
+ *   [ThreewayPrestartProvider] (Flutter's documented recommendation: an engine created and run at
+ *   Application start). As `prestart`, the provider acts on what the PREVIOUS launch asked for.
+ *
+ * The Dart side takes its marks on the wall clock and sends them over the `threeway` method channel
+ * after taking them (main.dart), so the channel's latency is in no mark.
+ */
+internal object ThreewayFlutter {
+  private const val CHANNEL = "threeway"
+
+  /** The engine this process pre-warmed and the experiments it ran with; taken once. */
+  private var prewarmed: Pair<FlutterEngine, String>? = null
+
+  /** Dart's messages, queued until the activity sets [handler] (a pre-warmed engine reports early). */
+  private val queue = ArrayList<Pair<String, Map<*, *>>>()
+  private var handler: ((String, Map<*, *>) -> Unit)? = null
+
+  /** The channel, for messages to Dart (startScroll). */
+  var channel: MethodChannel? = null
+    private set
+
+  /** Main thread. */
+  fun prewarm(context: Context, experiments: String) {
+    ColdStart.mark("flutterPrewarm")
+    val began = SystemClock.elapsedRealtimeNanos()
+    val engine = create(context, experiments)
+    prewarmed = engine to experiments
+    ColdStart.mainThreadNanos("flutterPrewarmMain", SystemClock.elapsedRealtimeNanos() - began)
+    Log.i("Threeway", "flutter: engine pre-warmed in bindApplication (x=$experiments)")
+  }
+
+  fun takePrewarmed(experiments: String): FlutterEngine? {
+    val p = prewarmed ?: return null
+    prewarmed = null
+    if (p.second != experiments) {
+      Log.w("Threeway", "flutter: pre-warmed with x=${p.second}, this launch has x=$experiments; not used")
+      p.first.destroy()
+      return null
+    }
+    return p.first
+  }
+
+  /** Main thread: a new engine (loads libflutter.so and libapp.so), its channel, its Dart entrypoint run. */
+  fun create(context: Context, experiments: String): FlutterEngine {
+    ColdStart.mark("flutterEngineStart")
+    val engine = FlutterEngine(context.applicationContext)
+    ColdStart.mark("flutterEngineCreated")
+    val channel = MethodChannel(engine.dartExecutor.binaryMessenger, CHANNEL)
+    channel.setMethodCallHandler { call, result ->
+      deliver(call.method, call.arguments as? Map<*, *> ?: emptyMap<Any, Any>())
+      result.success(null)
+    }
+    this.channel = channel
+    engine.dartExecutor.executeDartEntrypoint(
+      DartExecutor.DartEntrypoint.createDefault(),
+      listOf("x=$experiments", "api=${ThreewayHttp.apiBase}"),
+    )
+    ColdStart.mark("flutterEntrypointRun")
+    return engine
+  }
+
+  /** Platform (main) thread, as the channel delivers. */
+  private fun deliver(method: String, args: Map<*, *>) {
+    val h = handler
+    if (h == null) queue += method to args else h(method, args)
+  }
+
+  /** Main thread: the activity's handler; queued messages first. */
+  fun setHandler(h: ((String, Map<*, *>) -> Unit)?) {
+    handler = h
+    if (h != null) {
+      val pending = ArrayList(queue)
+      queue.clear()
+      pending.forEach { (m, a) -> h(m, a) }
+    }
+  }
+}
